# TripTree — Apache configuration

ErrorDocument 404 /404.html

<IfModule mod_alias.c>
    # Old template / renamed URLs -> new pages (keeps any existing links and search results working)
    Redirect 301 /index-5.html /
    Redirect 301 "/Bandipur Farmhouse.html" /bandipur-farmhouse.html
    Redirect 301 "/Harangi Backwatrers.html" /harangi-backwaters.html
    Redirect 301 "/Masinagudi Estate.html" /masinagudi-estate.html
    Redirect 301 /booking-enquiry.html /mudumalai-estate.html
    Redirect 301 /booking-reservation.html /booking.html
    Redirect 301 /booking-banner.html /booking.html
    Redirect 301 /room-grid.html /properties.html
    Redirect 301 /room-list.html /properties.html
    Redirect 301 /gallery-2.html /gallery.html
    Redirect 301 /error.html /404.html
    RedirectMatch 301 ^/index-([0-9]+)\.html$ /
    RedirectMatch 301 ^/(history|testimonials|services|restaurant|spa-relax|activities|promotions)\.html$ /about.html
    RedirectMatch 301 ^/(blog|blog-details|blog-with-column|blog-with-sidebar|comming-soon)\.html$ /

    # Never serve archived template files or macOS metadata
    RedirectMatch 404 ^/_(archive|build)(/.*)?$
    RedirectMatch 404 /\.DS_Store$
</IfModule>

Options -Indexes

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
